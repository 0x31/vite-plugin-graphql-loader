{
    "name": "graphql-loader-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "test": "vitest",
        "test:run": "vitest run && bun test tests/bun.spec.ts tests/smoke.spec.ts",
        "typecheck": "tsgo --noEmit",
        "build": "bun run --filter vite-plugin-graphql-loader build && bun run --filter bun-graphql-loader build",
        "lint": "oxlint --type-aware --ignore-pattern integration-test",
        "lint:fix": "bun run lint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "@babel/parser": "^7.29.9",
        "@babel/traverse": "^8.0.6",
        "@types/babel__traverse": "^7.28.0",
        "@types/bun": "^1.3.0",
        "@types/node": "^26.6.2",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "graphql": "^16",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "oxlint-tsgolint": "^7.0.2002",
        "rimraf": "^6.1.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
